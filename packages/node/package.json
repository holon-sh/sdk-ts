{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Typed MCP clients and app view resources for Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "slot": "generated",
    "contractVersion": 2
  },
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./view": {
      "types": "./view.d.ts",
      "import": "./view.js"
    },
    "./context": {
      "types": "./context.d.ts",
      "import": "./context.mjs"
    },
    "./protocol": {
      "types": "./protocol.d.ts",
      "import": "./runtime.mjs"
    }
  },
  "files": [
    "runtime.mjs",
    "runtime.d.ts",
    "validate.mjs",
    "protocol.d.ts",
    "view.js",
    "view.d.ts",
    "context.mjs",
    "context.d.ts",
    "generated/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "docs:build": "node scripts/build-reference.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
