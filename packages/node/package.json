{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Typed MCP clients and the caller of an MCP request, for Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "contractVersion": 2
  },
  "exports": {
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./context": {
      "types": "./context.d.ts",
      "import": "./context.mjs"
    },
    "./protocol": {
      "types": "./protocol.d.ts",
      "import": "./runtime.mjs"
    }
  },
  "imports": {
    "#platform": {
      "node": "./platform.node.mjs",
      "default": "./platform.browser.mjs"
    }
  },
  "files": [
    "runtime.mjs",
    "runtime.d.ts",
    "files.mjs",
    "platform.node.mjs",
    "platform.browser.mjs",
    "validate.mjs",
    "protocol.d.ts",
    "context.mjs",
    "context.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "ipaddr.js": "^2.5.0",
    "undici": "^7.16.0"
  }
}
