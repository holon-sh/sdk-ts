{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Typed MCP clients, MCP Events, and the caller of an MCP request, for Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "contractVersion": 2
  },
  "exports": {
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./context": {
      "types": "./context.d.ts",
      "import": "./context.mjs"
    },
    "./events": {
      "types": "./events.d.ts",
      "import": "./events.mjs"
    },
    "./protocol": {
      "types": "./protocol.d.ts",
      "import": "./runtime.mjs"
    }
  },
  "files": [
    "runtime.mjs",
    "runtime.d.ts",
    "validate.mjs",
    "protocol.d.ts",
    "context.mjs",
    "context.d.ts",
    "events.mjs",
    "events.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
