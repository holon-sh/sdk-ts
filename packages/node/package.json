{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Typed MCP clients, MCP Events, and the caller of an MCP request, for Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./ext/events": {
      "types": "./dist/ext/events.d.ts",
      "import": "./dist/ext/events.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./ext/files": {
      "types": "./dist/ext/files.d.ts",
      "import": "./dist/ext/files.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime": ["./dist/runtime.d.ts"],
      "context": ["./dist/context.d.ts"],
      "ext/events": ["./dist/ext/events.d.ts"],
      "protocol": ["./dist/protocol.d.ts"],
      "ext/files": ["./dist/ext/files.d.ts"]
    }
  },
  "imports": {
    "#platform": {
      "node": "./dist/ext/platform.node.js",
      "default": "./dist/ext/platform.browser.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.ts && tsc",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "ipaddr.js": "^2.5.0",
    "undici": "^7.16.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
