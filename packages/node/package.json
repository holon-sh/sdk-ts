{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Typed MCP clients, MCP Events, and the caller of an MCP request, for Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "contractVersion": 2
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "context": [
        "./dist/context.d.ts"
      ],
      "events": [
        "./dist/events.d.ts"
      ],
      "webhooks": [
        "./dist/webhooks.d.ts"
      ],
      "protocol": [
        "./dist/protocol.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.ts && tsc",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
