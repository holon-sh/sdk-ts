{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Typed MCP clients and app view resources for Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "slot": "generated",
    "contractVersion": 1
  },
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./view": {
      "types": "./view.d.ts",
      "import": "./view.js"
    },
    "./protocol": {
      "types": "./protocol.d.ts"
    },
    "./app": {
      "types": "./app.d.ts",
      "import": "./app.js"
    }
  },
  "files": [
    "runtime.mjs",
    "runtime.d.ts",
    "validate.mjs",
    "protocol.d.ts",
    "view.js",
    "view.d.ts",
    "generated/",
    "README.md",
    "app.js",
    "app.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "docs:build": "node scripts/build-reference.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@modelcontextprotocol/server": "^2.3.1"
  }
}
