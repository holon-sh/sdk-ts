{
  "name": "sdk-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/node"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build -w packages/node",
    "typecheck": "npm run build && tsc",
    "lint:package": "tarball=$(npm pack -w packages/node --silent) && publint run \"$tarball\" && attw \"$tarball\" --ignore-rules cjs-resolves-to-esm",
    "test": "npm run typecheck && node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "^22.0.0",
    "publint": "0.3.25",
    "typescript": "~7.0.2",
    "zod": "4.6.7"
  }
}
